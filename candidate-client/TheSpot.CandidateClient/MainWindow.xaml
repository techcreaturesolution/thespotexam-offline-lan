<Window x:Class="TheSpot.CandidateClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TheSpot Exam — Candidate" Width="1366" Height="768" MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" FontSize="15"
        FontFamily="Segoe UI" Foreground="{StaticResource Ink}" UseLayoutRounding="True">
    <Grid>
        <!-- CONNECT -->
        <Grid x:Name="ConnectView">
            <Border Style="{StaticResource CardBorder}" Width="680" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Style="{StaticResource Title}" Text="Connect to the exam center"/>
                    <TextBlock Style="{StaticResource Label}" Margin="0" Text="This PC talks only to the Center Server on the local network."/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="DiscoverButton" Content="Search the LAN" Click="Discover_Click"/>
                        <TextBlock x:Name="DiscoverStatus" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                    <ListBox x:Name="DiscoveredList" Margin="0,10,0,0" MaxHeight="150" SelectionChanged="Discovered_SelectionChanged"
                             Visibility="Collapsed" BorderBrush="{StaticResource Line}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Address}" Foreground="{StaticResource Muted}" FontSize="13"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Style="{StaticResource Label}" Text="Or enter the server address"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HostBox" Margin="0,0,8,0" ToolTip="IP address of the Center Server"/>
                        <TextBox x:Name="PortBox" Grid.Column="1" Text="8443" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Style="{StaticResource Secondary}" Margin="0" Content="Check" Click="Probe_Click"/>
                    </Grid>
                    <Border x:Name="FingerprintPanel" Visibility="Collapsed" Margin="0,18,0,0" Padding="14" CornerRadius="8" Background="#FFF8E1" BorderBrush="#F0C36D" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="FingerprintSource" FontWeight="SemiBold"/>
                            <TextBlock x:Name="FingerprintText" FontFamily="Consolas" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,6"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="13"
                                       Text="Invigilator: confirm this matches the SHA-256 fingerprint shown on the Center Server console. It is stored on this PC; a different certificate will be refused."/>
                            <StackPanel x:Name="PinPasswordRow" Margin="0,8,0,0">
                                <TextBlock Text="Invigilator password" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
                                <PasswordBox x:Name="PinPasswordBox"/>
                            </StackPanel>
                            <Button x:Name="ConfirmPinButton" Content="Fingerprint matches — connect" Margin="0,12,0,0" HorizontalAlignment="Left" Click="ConfirmPin_Click"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ConnectStatus" Style="{StaticResource Error}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- LOGIN -->
        <Grid x:Name="LoginView" Visibility="Collapsed">
            <Border Style="{StaticResource CardBorder}" Width="460" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Style="{StaticResource Title}" Text="Candidate login"/>
                    <TextBlock x:Name="CenterNameText" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource Label}" Text="Roll number"/>
                    <TextBox x:Name="RollBox" CharacterCasing="Upper"/>
                    <TextBlock Style="{StaticResource Label}" Text="Password"/>
                    <PasswordBox x:Name="PasswordBox"/>
                    <Button x:Name="LoginButton" Content="Log in" IsDefault="True" Margin="0,20,0,0" Click="Login_Click"/>
                    <TextBlock x:Name="LoginStatus" Style="{StaticResource Error}"/>
                    <TextBlock x:Name="MachineText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,18,0,0" TextWrapping="Wrap"/>
                    <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,4,0,0" Content="Change server (invigilator)" Click="ChangeServer_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- EXAM -->
        <Grid x:Name="ExamView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Border Background="{StaticResource Header}" Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ExamTitleText" Foreground="White" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="CandidateText" Foreground="#B8C4D9" FontSize="13"/>
                    </StackPanel>
                    <Border x:Name="ConnBorder" Grid.Column="1" CornerRadius="14" Padding="12,5" Margin="16,0" VerticalAlignment="Center" Background="#1E7A46">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ConnDot" Width="10" Height="10" Fill="#7CF0A8" Margin="0,0,8,0"/>
                            <TextBlock x:Name="ConnText" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="TIME LEFT" Foreground="#B8C4D9" FontSize="11" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="TimerText" Foreground="White" FontSize="30" FontFamily="Consolas" FontWeight="Bold" Text="--:--"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="310"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardBorder}" Padding="22,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <WrapPanel x:Name="SectionBar" Margin="0,0,0,10"/>
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <TextBlock x:Name="QNumText" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock x:Name="MarksText" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/>
                        </Grid>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock x:Name="QuestionText" FontSize="18" TextWrapping="Wrap" LineHeight="27"/>
                                <TextBlock x:Name="HintText" Foreground="{StaticResource Muted}" FontStyle="Italic" Margin="0,10,0,6"/>
                                <StackPanel x:Name="OptionsPanel"/>
                            </StackPanel>
                        </ScrollViewer>
                        <Grid Grid.Row="3" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="PrevButton" Style="{StaticResource Secondary}" Content="◀  Previous" Click="Prev_Click"/>
                                <Button x:Name="ClearButton" Style="{StaticResource Secondary}" Content="Clear answer" Click="Clear_Click"/>
                                <Button x:Name="FlagButton" Style="{StaticResource Secondary}" Content="Flag for review" Click="Flag_Click"/>
                            </StackPanel>
                            <Button x:Name="NextButton" HorizontalAlignment="Right" Margin="0" Content="Save &amp; Next  ▶" Click="Next_Click"/>
                        </Grid>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Question palette" FontWeight="SemiBold" FontSize="16"/>
                            <UniformGrid Columns="2" Margin="0,8,0,8">
                                <StackPanel Orientation="Horizontal" Margin="0,2"><Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="{StaticResource Answered}" Margin="0,0,6,0"/><TextBlock Text="Answered" FontSize="13"/></StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2"><Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="{StaticResource NotAnswered}" Margin="0,0,6,0"/><TextBlock Text="Not answered" FontSize="13"/></StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2"><Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="{StaticResource Flagged}" Margin="0,0,6,0"/><TextBlock Text="Flagged" FontSize="13"/></StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2"><Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="{StaticResource NotVisited}" Margin="0,0,6,0"/><TextBlock Text="Not visited" FontSize="13"/></StackPanel>
                            </UniformGrid>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="PalettePanel"/>
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" Margin="0,10,0,0">
                            <TextBlock x:Name="SummaryText" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Button x:Name="SubmitButton" Margin="0" Background="{StaticResource Answered}" Content="Submit exam" Click="Submit_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="PhaseOverlay" Grid.RowSpan="2" Grid.Row="1" Style="{StaticResource Overlay}">
                <Border Style="{StaticResource CardBorder}" Width="560" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="PhaseTitle" Style="{StaticResource Title}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="PhaseDetail" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- FINISHED -->
        <Grid x:Name="FinishedView" Visibility="Collapsed">
            <Border Style="{StaticResource CardBorder}" Width="620" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="FinishedTitle" Style="{StaticResource Title}" Text="Exam submitted"/>
                    <TextBlock x:Name="FinishedDetail" TextWrapping="Wrap" FontSize="16"/>
                    <TextBlock x:Name="FinishedSync" TextWrapping="Wrap" Margin="0,14,0,0" Foreground="{StaticResource Muted}"/>
                    <TextBlock Text="Please remain seated until the invigilator tells you to leave." Margin="0,14,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- SUBMIT CONFIRMATION -->
        <Grid x:Name="SubmitOverlay" Style="{StaticResource Overlay}">
            <Border Style="{StaticResource CardBorder}" Width="520" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Style="{StaticResource Title}" Text="Submit your exam?"/>
                    <TextBlock x:Name="SubmitSummaryText" TextWrapping="Wrap"/>
                    <TextBlock Text="After submitting you cannot change any answer." Foreground="{StaticResource Danger}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Secondary}" Content="Go back" Click="CancelSubmit_Click"/>
                        <Button x:Name="ConfirmSubmitButton" Margin="0" Background="{StaticResource Answered}" Content="Yes, submit" Click="ConfirmSubmit_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- INVIGILATOR -->
        <Grid x:Name="InvigilatorOverlay" Style="{StaticResource Overlay}">
            <Border Style="{StaticResource CardBorder}" Width="460" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Style="{StaticResource Title}" Text="Invigilator"/>
                    <TextBlock x:Name="InvigilatorPrompt" TextWrapping="Wrap"/>
                    <PasswordBox x:Name="InvigilatorPassword" Margin="0,12,0,0"/>
                    <TextBlock x:Name="InvigilatorStatus" Style="{StaticResource Error}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Secondary}" Content="Cancel" Click="InvigilatorCancel_Click"/>
                        <Button Margin="0" Content="Confirm" Click="InvigilatorOk_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="Toast" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24"
                Background="#E6C62828" CornerRadius="8" Padding="16,8" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Foreground="White" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
